# Dependencies, caches and local application state
node_modules/
.DS_Store
__pycache__/
*.py[cod]
.venv/
.env
.env.*
!.env.example
.data_agent/
.local/

# Build outputs and test/evaluation evidence
/out/
/dist/
/release/
/runtime/
/test-results/
/coverage/
/playwright-report/
/blob-report/
/evaluations/results/
*.log
*.tsbuildinfo

# Machine-specific research and one-off validation conclusions (kept locally)
/docs/research/
/docs/validation-report.md

# Only maintained, reusable validation sources are versioned.
# Add new helpers explicitly; never force-add dependencies, evidence or secrets.
/validation/*
!/validation/README.md
!/validation/pi/
!/validation/electron/
!/validation/runtime/
!/validation/policy/

/validation/pi/*
!/validation/pi/README.md
!/validation/pi/package.json
!/validation/pi/package-lock.json
!/validation/pi/verify.mjs
!/validation/pi/pi-smoke.mjs
!/validation/pi/run-live.py

/validation/electron/*
!/validation/electron/README.md
!/validation/electron/package.json
!/validation/electron/package-lock.json
!/validation/electron/*.cjs
!/validation/electron/supervisor.py
!/validation/electron/index.html
!/validation/electron/markdown.jsx
!/validation/electron/resource-probe.txt

/validation/runtime/*
!/validation/runtime/README.md
!/validation/runtime/bootstrap.sh
!/validation/runtime/bootstrap-tools.sh
!/validation/runtime/tools-probe.py
!/validation/runtime/verify-hash-install.py
!/validation/runtime/requirements.in
!/validation/runtime/requirements.lock
!/validation/runtime/requirements.hashed.lock

/validation/policy/*
!/validation/policy/probe.py
