{
  "name": "data-agent",
  "version": "0.1.0",
  "private": true,
  "description": "A local AI workbench for data analysis",
  "author": "Data Agent",
  "type": "module",
  "main": "out/main/index.js",
  "packageManager": "pnpm@10.14.0",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:cdp": "node scripts/test/dev-cdp.mjs",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "package:dir": "pnpm build && electron-builder --mac dir --arm64",
    "native:rebuild": "electron-rebuild -f -w better-sqlite3",
    "check": "tsc --noEmit && node scripts/test/check.mjs",
    "test:unit": "vitest run tests/unit",
    "test:integration": "node scripts/test/verify.mjs --integration",
    "test:e2e": "node scripts/test/verify.mjs --e2e",
    "test:e2e:packaged": "node scripts/test/verify.mjs --packaged",
    "verify:phase": "node scripts/test/verify.mjs"
  },
  "dependencies": {
    "@radix-ui/react-slot": "1.2.4",
    "@radix-ui/react-dialog": "1.1.15",
    "better-sqlite3": "13.0.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "0.555.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "streamdown": "2.7.1",
    "tailwind-merge": "3.4.0",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@electron/rebuild": "4.2.1",
    "@tailwindcss/vite": "4.1.17",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "24.10.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.1.1",
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "electron-vite": "5.0.0",
    "playwright-core": "1.65.0",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "vite": "7.2.2",
    "vitest": "3.2.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["electron", "esbuild", "better-sqlite3"]
  }
}
