{
  "name": "data-agent",
  "version": "0.1.0",
  "private": true,
  "description": "A local AI workbench for data analysis",
  "author": "Data Agent",
  "type": "module",
  "main": "out/main/index.js",
  "packageManager": "pnpm@10.14.0",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:cdp": "node scripts/test/dev-cdp.mjs",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "package:dir": "node scripts/build/package.mjs",
    "native:rebuild": "electron-rebuild -f -w better-sqlite3",
    "check": "tsc --noEmit && node scripts/test/check.mjs",
    "test:unit": "node scripts/test/verify.mjs --level unit",
    "test:integration": "node scripts/test/verify.mjs --level integration",
    "test:e2e": "node scripts/test/verify.mjs --level e2e",
    "test:e2e:packaged": "node scripts/test/verify.mjs --level e2e --packaged",
    "test:e2e:packaged:live": "node scripts/test/verify.mjs --level e2e --packaged --live",
    "verify:phase": "node scripts/test/verify.mjs",
    "test:integration:live": "node scripts/test/verify.mjs --case models.live-conversation --live",
    "runtime:prepare": "node scripts/build/prepare-runtime.mjs",
    "runtime:verify": "node scripts/build/verify-runtime.mjs",
    "eval:prepare": "pnpm build && node scripts/eval/prepare.mjs",
    "test:e2e:live": "node scripts/test/verify.mjs --level e2e --live",
    "verify:release": "node scripts/build/verify-release.mjs",
    "prepare": "husky",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix --max-warnings=0",
    "quality": "pnpm format:check && pnpm lint && pnpm check",
    "test:tooling": "node --test tests/tooling/*.test.mjs",
    "test": "node scripts/test/verify.mjs",
    "test:list": "node scripts/test/verify.mjs --list",
    "test:live": "node scripts/test/verify.mjs --level e2e --live"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "1.5.0",
    "@earendil-works/pi-coding-agent": "1.5.0",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-popover": "1.1.15",
    "@radix-ui/react-slot": "1.2.4",
    "@radix-ui/react-tabs": "1.2.1",
    "@radix-ui/react-tooltip": "1.4.1",
    "better-sqlite3": "13.0.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "highlight.js": "11.11.1",
    "lucide-react": "0.555.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "streamdown": "2.7.1",
    "tailwind-merge": "3.4.0",
    "typebox": "1.3.27",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@electron/rebuild": "4.2.1",
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.1.17",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "24.10.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.1.1",
    "echarts": "6.1.0",
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "electron-vite": "5.0.0",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "husky": "9.1.7",
    "lint-staged": "16.4.0",
    "playwright-core": "1.65.0",
    "prettier": "3.9.10",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "unified": "11.0.5",
    "vite": "7.2.2",
    "vitest": "3.2.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild",
      "better-sqlite3"
    ]
  }
}
